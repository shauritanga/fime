# Copy to .env (never commit it).

# groq (any OpenAI-style API) | anthropic (Claude, paid) | mock (no key, for testing the app)
LLM_PROVIDER=groq

# Groq: https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Claude, if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Budget protection
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_PER_DAY=300
# DAILY_REQUEST_CAP=2000
# TRUST_PROXY=true            # only behind your own reverse proxy
