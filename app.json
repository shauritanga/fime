{
  "expo": {
    "name": "Fime",
    "slug": "fime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fime_logo.png",
    "scheme": "fime",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shauritanga.fime"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090D16",
        "foregroundImage": "./assets/images/android-icon-fime-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.shauritanga.fime"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/fime_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fime_logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F2EA"
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Fime uses the microphone only while you record a question for the assistant.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad87baa8-2bb6-461f-a8a1-13fb166fb532"
      }
    },
    "owner": "ashauritanga"
  }
}
